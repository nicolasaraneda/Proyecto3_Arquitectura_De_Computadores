# Virtual Environments & Editor Files
.venv/
venv/
.DS_Store

# Python & Test Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# FPGA Synthesis & Bitstream Artifacts (Yosys / nextpnr / icepack)
*.json
*.asc
*.bin
*.log
module_stats/

# Simulation Artifacts (Iverilog / GTKWave / Cocotb)
sim/sim
*.vcd
*.csv

# Build artifacts and simulation firmware (regenerables con `make`).
# sw/game.hex NO va aca: esta versionado y es parte de la entrega.
build/
sw/game_sim*.hex

# Corridas de LibreLane (pesadas; los reportes que se usen en el informe se copian aparte)
asic/**/runs/

# Las metricas de cada corrida copiada a resultados/ si se versionan, aunque *.json
# este excluido mas arriba (son la fuente de las tablas de asic/barrido.md).
!asic/**/resultados/**/metrics.json
!asic/p2_original/evidencia/**/metrics.json

# Logs del barrido de LibreLane (asic/barrido.sh)
asic/logs/

# Programa de prueba del core (make asm-all lo ensambla, pero no es parte de la entrega)
sw/isa_test.hex
